generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INVESTOR
  LISTER
  ADMIN
  TENANT
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PropertyStatus {
  DRAFT
  LISTED
  FUNDED
  RENT_LISTED
  RENTED
  SOLD
}

enum ListingStatus {
  DRAFT
  LISTED
  WITHDRAWN
}

enum PropertyType {
  HOUSE
  TOWNHOME
  APARTMENT
  CONDO
}

enum SourceType {
  OWNER
  PUBLIC
  PARTNER
  MLS
}

enum SellOrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

enum BuyOrderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

enum BuyOrderType {
  MARKET
  LIMIT
}

enum SellOrderStrategy {
  MAX_PRICE
  BALANCED
  FAST_EXIT
}

enum NotificationType {
  TARGETED_OFFER
  SYSTEM
  DOCUMENT
  TRADE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentEntityType {
  PROPERTY
  TRANSACTION
  ORDER
  USER
}

enum DocumentKind {
  DEED
  APPRAISAL
  INSPECTION
  OFFERING_MEMO
  KYC
  TRADE_CONFIRMATION
  SUBSCRIPTION_AGREEMENT
  OTHER
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  EXPORT
  CONFIG_CHANGE
}

enum PlatformConfigScope {
  PLATFORM
  MARKET
  COMPLIANCE
  ANALYTICS
  AI
  BLOCKCHAIN
}

model TargetingRuleConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String   @unique
  ownsPropertyWeight    Int      @default(40)
  viewScorePerCount     Int      @default(6)
  maxViewScore          Int      @default(30)
  similarHoldingsWeight Int      @default(20)
  recentBuyerWeight     Int      @default(10)
  minScoreToTarget      Int      @default(1)
  maxBuyersPerOrder     Int      @default(20)
  cooldownHours         Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MarketRuleConfig {
  id                          String   @id @default(uuid()) @db.Uuid
  name                        String   @unique
  liquidityGoodThreshold      Int      @default(70)
  liquidityMidThreshold       Int      @default(50)
  liquidityLookbackDays       Int      @default(14)
  liquidityTradeWeight        Int      @default(40)
  liquidityTimeWeight         Int      @default(35)
  liquidityDeviationWeight    Int      @default(25)
  liquidityTradeCountCap      Int      @default(10)
  liquidityTimeToFillMaxHours Int      @default(168)
  referenceWeightPrimary      Decimal  @default(0.4) @db.Decimal(4, 3)
  referenceWeightSecondary    Decimal  @default(0.4) @db.Decimal(4, 3)
  referenceWeightNav          Decimal  @default(0.2) @db.Decimal(4, 3)
  strategyMultiplierFastExit  Decimal  @default(0.95) @db.Decimal(6, 3)
  strategyMultiplierBalanced  Decimal  @default(1.0) @db.Decimal(6, 3)
  strategyMultiplierMaxPrice  Decimal  @default(1.03) @db.Decimal(6, 3)
  maxPriceCapMultiplier       Decimal  @default(1.2) @db.Decimal(6, 3)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String?            @unique
  phone              String?            @unique
  passwordHash       String
  role               UserRole
  emailVerified      Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  aiSummaryCache     String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  kycProfile         KycProfile?
  listings           Listing[]           @relation("UserListings")
  holdings           Holding[]
  sellOrders         SellOrder[]
  buyerTrades        Trade[]             @relation("BuyerTrades")
  sellerTrades       Trade[]             @relation("SellerTrades")
  rentalApplications RentalApplication[] @relation("TenantApplications")
  verificationTokens VerificationToken[]
  notifications      Notification[]
  targetedOffers     TargetedOffer[]     @relation("TargetedOffersBuyer")
  propertyViews      PropertyView[]
  buyOrders          BuyOrder[]
  uploadedDocuments  Document[]          @relation("DocumentUploader")
  auditLogs          AdminAuditLog[]     @relation("AuditActorUser")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([verificationStatus])
}

model VerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model KycProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  status      KycStatus
  data        Json
  submittedAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Property {
  id                 String             @id @default(uuid()) @db.Uuid
  type               PropertyType       @default(HOUSE)
  address1           String
  city               String
  state              String
  zip                String
  status             PropertyStatus
  liquidityScore     Int                @default(50)
  sourceType         SourceType?
  sourceRefId        String?
  importedAt         DateTime?
  sourceAttribution  String?
  squareFeet         Int?
  bedrooms           Int?
  bathrooms          Int?
  targetRaise        Decimal?           @db.Decimal(14, 2)
  estMonthlyRent     Decimal?           @db.Decimal(14, 2)
  lastTradeAt        DateTime?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  aiSummaryCache     String?            @db.Text
  blockchainTxHash   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  listings           Listing[]
  images             PropertyImage[]
  shareClass         ShareClass?
  sellOrders         SellOrder[]
  trades             Trade[]
  rentalApplications RentalApplication[]
  propertyViews      PropertyView[]
  notifications      Notification[]
  buyOrders          BuyOrder[]
  documents          Document[]

  @@index([city, state])
  @@index([status])
  @@index([verificationStatus])
  @@index([sourceType, status])
}

enum RentalApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model RentalApplication {
  id           String                  @id @default(uuid()) @db.Uuid
  propertyId   String                  @db.Uuid
  tenantUserId String                  @db.Uuid
  status       RentalApplicationStatus @default(PENDING)
  rentAmount   Decimal?                @db.Decimal(12, 2)
  createdAt    DateTime                @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User     @relation("TenantApplications", fields: [tenantUserId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantUserId])
  @@index([status])
}

model MLSListing {
  id           String     @id @default(uuid()) @db.Uuid
  externalId   String     @unique
  sourceType   SourceType
  address      String
  city         String
  state        String
  zip          String
  listPrice    Decimal    @db.Decimal(14, 2)
  rentEstimate Decimal    @db.Decimal(14, 2)
  beds         Int
  baths        Decimal    @db.Decimal(4, 1)
  sqft         Int
  yearBuilt    Int
  images       String[]
  thumbUrl     String
  status       String
  attribution  String
  createdAt    DateTime   @default(now())

  @@index([sourceType])
  @@index([city, state])
  @@index([externalId])
}

model Listing {
  id           String        @id @default(uuid()) @db.Uuid
  propertyId   String        @db.Uuid
  listerUserId String        @db.Uuid
  bonusPercent Decimal       @db.Decimal(6, 3)
  askingPrice  Decimal       @db.Decimal(14, 2)
  status       ListingStatus
  postedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lister   User     @relation("UserListings", fields: [listerUserId], references: [id], onDelete: Restrict)

  @@index([propertyId])
  @@index([listerUserId])
  @@index([status])
}

model PropertyImage {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid
  url        String
  sortOrder  Int

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([sortOrder])
}

model ShareClass {
  id                     String    @id @default(uuid()) @db.Uuid
  propertyId             String    @unique @db.Uuid
  totalShares            Int
  sharesAvailable        Int
  referencePricePerShare Decimal   @db.Decimal(14, 4)
  lastReferenceUpdateAt  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  holdings Holding[]

  @@index([propertyId])
}

model Holding {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  shareClassId String   @db.Uuid
  sharesOwned  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareClass ShareClass @relation(fields: [shareClassId], references: [id], onDelete: Cascade)

  @@unique([userId, shareClassId])
  @@index([userId])
  @@index([shareClassId])
}

model SellOrder {
  id                       String             @id @default(uuid()) @db.Uuid
  userId                   String             @db.Uuid
  propertyId               String             @db.Uuid
  sharesForSale            Int
  remainingShares          Int
  askPricePerShare         Decimal            @db.Decimal(14, 4)
  optimizedPricePerShare   Decimal?           @db.Decimal(14, 4)
  liquidityScoreAtCreation Int?
  strategy                 SellOrderStrategy  @default(BALANCED)
  status                   SellOrderStatus
  verificationStatus       VerificationStatus @default(UNVERIFIED)
  blockchainTxHash         String?
  aiSummaryCache           String?            @db.Text
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  trades         Trade[]
  targetedOffers TargetedOffer[]
  notifications  Notification[]
  documents      Document[]      @relation("SellOrderDocuments")

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
  @@index([verificationStatus])
}

model Trade {
  id                 String             @id @default(uuid()) @db.Uuid
  sellOrderId        String             @db.Uuid
  propertyId         String             @db.Uuid
  buyerUserId        String             @db.Uuid
  sellerUserId       String             @db.Uuid
  sharesTraded       Int
  pricePerShare      Decimal            @db.Decimal(14, 4)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  blockchainTxHash   String?
  aiSummaryCache     String?            @db.Text
  tradedAt           DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sellOrder SellOrder  @relation(fields: [sellOrderId], references: [id], onDelete: Cascade)
  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer     User       @relation("BuyerTrades", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller    User       @relation("SellerTrades", fields: [sellerUserId], references: [id], onDelete: Restrict)
  documents Document[] @relation("TradeDocuments")

  @@index([sellOrderId])
  @@index([propertyId])
  @@index([buyerUserId])
  @@index([sellerUserId])
  @@index([tradedAt])
  @@index([blockchainTxHash])
}

model BuyOrder {
  id                 String             @id @default(uuid()) @db.Uuid
  buyerUserId        String             @db.Uuid
  propertyId         String             @db.Uuid
  orderType          BuyOrderType
  sharesRequested    Int
  filledShares       Int                @default(0)
  maxPricePerShare   Decimal?           @db.Decimal(14, 4)
  status             BuyOrderStatus     @default(OPEN)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  blockchainTxHash   String?
  aiSummaryCache     String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  buyer     User       @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  documents Document[] @relation("BuyOrderDocuments")

  @@index([buyerUserId])
  @@index([propertyId])
  @@index([status])
  @@index([createdAt])
  @@index([verificationStatus])
}

model PropertyView {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  propertyId   String   @db.Uuid
  viewCount    Int      @default(1)
  lastViewedAt DateTime @updatedAt
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@index([lastViewedAt])
}

model TargetedOffer {
  id          String   @id @default(uuid()) @db.Uuid
  sellOrderId String   @db.Uuid
  buyerUserId String   @db.Uuid
  score       Int
  createdAt   DateTime @default(now())

  sellOrder SellOrder @relation(fields: [sellOrderId], references: [id], onDelete: Cascade)
  buyer     User      @relation("TargetedOffersBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)

  @@unique([sellOrderId, buyerUserId])
  @@index([buyerUserId])
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  sellOrderId String?          @db.Uuid
  propertyId  String?          @db.Uuid
  type        NotificationType
  message     String
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellOrder SellOrder? @relation(fields: [sellOrderId], references: [id], onDelete: Cascade)
  property  Property?  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, sellOrderId, type])
  @@index([userId])
  @@index([createdAt])
  @@index([propertyId])
}

model Document {
  id                 String             @id @default(uuid()) @db.Uuid
  uploadedByUserId   String?            @db.Uuid
  propertyId         String?            @db.Uuid
  tradeId            String?            @db.Uuid
  buyOrderId         String?            @db.Uuid
  sellOrderId        String?            @db.Uuid
  entityType         DocumentEntityType
  kind               DocumentKind       @default(OTHER)
  status             DocumentStatus     @default(ACTIVE)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  fileName           String
  fileUrl            String
  mimeType           String?
  fileSizeBytes      Int?
  aiSummaryCache     String?            @db.Text
  blockchainTxHash   String?
  metadata           Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  uploadedBy User?      @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  trade      Trade?     @relation("TradeDocuments", fields: [tradeId], references: [id], onDelete: Cascade)
  buyOrder   BuyOrder?  @relation("BuyOrderDocuments", fields: [buyOrderId], references: [id], onDelete: Cascade)
  sellOrder  SellOrder? @relation("SellOrderDocuments", fields: [sellOrderId], references: [id], onDelete: Cascade)

  @@index([uploadedByUserId])
  @@index([propertyId])
  @@index([tradeId])
  @@index([buyOrderId])
  @@index([sellOrderId])
  @@index([entityType, status])
  @@index([verificationStatus])
  @@index([createdAt])
}

model AdminAuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorUserId  String?        @db.Uuid
  actorType    AuditActorType @default(ADMIN)
  action       AuditAction
  entityType   String
  entityId     String?
  targetUserId String?        @db.Uuid
  propertyId   String?        @db.Uuid
  tradeId      String?        @db.Uuid
  metadata     Json?
  createdAt    DateTime       @default(now())

  actorUser User? @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([actorType, action])
  @@index([entityType, entityId])
  @@index([targetUserId])
  @@index([propertyId])
  @@index([tradeId])
  @@index([createdAt])
}

model PlatformConfig {
  id               String              @id @default(uuid()) @db.Uuid
  scope            PlatformConfigScope
  key              String
  value            Json
  description      String?
  isActive         Boolean             @default(true)
  aiSummaryCache   String?             @db.Text
  blockchainTxHash String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([scope, key])
  @@index([scope, isActive])
}
